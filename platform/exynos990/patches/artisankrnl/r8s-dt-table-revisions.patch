From: ArtisanROM contributors <noreply@github.com>
Subject: [PATCH] r8s: encode DT table revision selectors like stock

The current mkdtimg writes configuration integers in DT table byte order.
Pre-swapped values differ from the SM-G780F G780FXXSOFYJ2 tables.
Use stock selectors for r8s without changing other model tables or payloads.

diff --git a/build/dtconfigs/r8s.cfg b/build/dtconfigs/r8s.cfg
--- a/build/dtconfigs/r8s.cfg
+++ b/build/dtconfigs/r8s.cfg
@@ -1,11 +1,11 @@
 exynos990-r8s_eur_open_00.dtbo
   custom0=0x00000000
-  custom1=0x01000000
+  custom1=0x00000001
 
 exynos990-r8s_eur_open_02.dtbo
-  custom0=0x02000000
-  custom1=0x04000000
+  custom0=0x00000002
+  custom1=0x00000004
 
 exynos990-r8s_eur_open_05.dtbo
-  custom0=0x05000000
-  custom1=0xff000000
+  custom0=0x00000005
+  custom1=0x000000ff
diff --git a/build.sh b/build.sh
--- a/build.sh
+++ b/build.sh
@@ -199,7 +199,11 @@
 # Build dtb
 echo "Building common exynos9830 Device Tree Blob Image..."
 echo "-----------------------------------------------"
-./toolchain/mkdtimg cfg_create build/out/$MODEL/dtb.img build/dtconfigs/exynos9830.cfg -d out/arch/arm64/boot/dts/exynos
+COMMON_DTB_CONFIG=build/dtconfigs/exynos9830.cfg
+if [[ "$MODEL" == "r8s" ]]; then
+    COMMON_DTB_CONFIG=build/dtconfigs/exynos9830-r8s.cfg
+fi
+./toolchain/mkdtimg cfg_create build/out/$MODEL/dtb.img "$COMMON_DTB_CONFIG" -d out/arch/arm64/boot/dts/exynos
 
 # Build dtbo
 echo "Building Device Tree Blob Output Image for "$MODEL"..."
diff --git a/build/dtconfigs/exynos9830-r8s.cfg b/build/dtconfigs/exynos9830-r8s.cfg
new file mode 100644
--- /dev/null
+++ b/build/dtconfigs/exynos9830-r8s.cfg
@@ -0,0 +1,3 @@
+exynos9830.dtb
+  custom0=0x00000000
+  custom1=0x000000ff
