 		break;
 	case POWER_SUPPLY_STATUS_NOT_CHARGING:
@@ -8904,6 +8935,7 @@ static int sec_battery_probe(struct platform_device *pdev)
 	battery->charging_next_time = 0;
 	battery->charging_fullcharged_time = 0;
 	battery->siop_level = 100;
