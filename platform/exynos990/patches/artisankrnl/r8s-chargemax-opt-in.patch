 bool sleep_mode = false;
 bool batt_boot_complete = false;
+
+/* Adapted from the archived Benly ChargeMax v3 policy (off by default).
+ * Preserve raw SIOP, including an explicit zero request. No temperature,
+ * current, swelling, charger-IC, USB, health or safety-timer limits are raised.
+ * This switch needs physical charging validation before automatic enablement.
+ */
+bool sec_bat_charge_max_mode_active(struct sec_battery_info *battery)
+{
+	return READ_ONCE(battery->charge_max_mode) && battery->charging_enabled &&
+		!battery->store_mode && is_wired_type(battery->cable_type) &&
+		READ_ONCE(battery->siop_level) > 0;
+}
+
+int sec_bat_effective_charge_siop(struct sec_battery_info *battery)
+{
+	int siop_level = READ_ONCE(battery->siop_level);
+
+	/* Do not promote an observed userspace zero request to 100. */
+	if (siop_level > 0 && siop_level < 100 &&
+		sec_bat_charge_max_mode_active(battery))
+		return 100;
+	return siop_level;
+}
 
